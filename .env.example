# Copy to .env and adjust. docker compose reads this automatically.

# --- database ---
DB_USER=geopilot
DB_PASSWORD=change-me
DB_NAME=geopilot

# --- furnace (AWL controller on the LAN) ---
AWL_URL=http://192.168.1.50
AWL_PASSCODE=9999
AWL_ADDR=1

# --- poll cadence per tier (Go durations) ---
POLL_FAST=5s
POLL_MEDIUM=60s
POLL_SLOW=1h

# --- weather source (westmoreland.app-compatible /api/latest + /api/series) ---
WEATHER_URL=https://westmoreland.app
POLL_WEATHER=10m

# --- Bayou Energy (utility bills + interval usage) ---
# sign up at bayou.energy (free for 1 meter), then paste your API key here.
BAYOU_API_KEY=
BAYOU_CUSTOMER_ID=
